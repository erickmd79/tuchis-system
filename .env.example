# Copia este archivo como .env.local y ajusta los valores.

# WhatsApp del admin de TUCHIS (usado en "Enviar a TUCHIS" y "Volver a pedir")
# Formato: solo dígitos, con código de país, sin "+" (ej: 5212721342701 = +52 272 134 2701)
NEXT_PUBLIC_ADMIN_WHATSAPP=5212721342701

# Supabase (requerido)
NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<tu-anon-key>
